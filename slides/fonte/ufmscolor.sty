\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ufmscolor}[2026/04/02 Cores Oficiais UFMS]

\RequirePackage{xcolor}

% Cores Oficiais UFMS
\definecolor{ufmsazul}{RGB}{0, 136, 183}    % Azul Principal
\definecolor{ufmsamarelo}{RGB}{255, 204, 0} % Amarelo Detalhe
\definecolor{ufmsgrey}{RGB}{224, 224, 224}  % Cinza Claro

% Mapeamento para manter compatibilidade com o beamerthemesintef.sty
\colorlet{maincolor}{ufmsazul}
\colorlet{sintefgrey}{ufmsgrey}
\colorlet{sintefyellow}{ufmsamarelo}
\colorlet{sintefgreen}{ufmsazul!70!black} 
\colorlet{sinteflightgreen}{ufmsazul!20}
\colorlet{sintefdarkgreen}{ufmsazul!50!black}
\colorlet{sintefred}{red!70!black}
\colorlet{sinteflilla}{purple!70!black}