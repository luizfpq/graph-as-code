# Copie este arquivo para .env e preencha a chave do provedor que voce vai usar.
# O .env nao deve ser versionado (ja esta no .gitignore).

# Provedor padrao do projeto: OpenRouter (API compativel com OpenAI, varios modelos
# com uma unica chave). Preencha esta para rodar o exemplo como esta documentado.
OPENROUTER_API_KEY=

# Alternativa: chave da propria OpenAI (use com --provedor openai).
OPENAI_API_KEY=

# Alternativa: Maritaca (modelos em portugues).
MARITACA_API_KEY=

# Ollama roda local e nao usa chave. Ajuste apenas se o servidor
# nao estiver no endereco padrao (http://localhost:11434) ou se quiser
# aumentar o tempo limite (em segundos) para modelos lentos.
OLLAMA_TIMEOUT=
