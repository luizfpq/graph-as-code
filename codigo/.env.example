# Copie este arquivo para .env e preencha a chave do provedor que voce vai usar.
# O .env nao deve ser versionado (ja esta no .gitignore).

# Chave para a API da OpenAI (ou compativel via base_url no cliente).
OPENAI_API_KEY=

# Alternativas compativeis com OpenAI (preencha apenas a que for usar).
OPENROUTER_API_KEY=
MARITACA_API_KEY=

# Ollama roda local e nao usa chave. Ajuste apenas se o servidor
# nao estiver no endereco padrao (http://localhost:11434) ou se quiser
# aumentar o tempo limite (em segundos) para modelos lentos.
OLLAMA_TIMEOUT=
